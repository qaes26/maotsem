# ==============================================================
# 🔥 إعدادات منصة سين جيم - الربط بقاعدة بيانات Firebase و SMS الفعلي
# ==============================================================
# للحصول على هذه البيانات مجاناً:
# 1. ادخل إلى console.firebase.google.com وأنشئ مشروعاً جديداً.
# 2. من قسم Authentication -> Sign-in method -> قم بتفعيل "Phone".
# 3. من قسم Project Settings (إعدادات المشروع) -> أسفل الصفحة أضف تطبيق ويب (Web App </>) وانسخ القيم وضعها هنا:

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=seen-jeem.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seen-jeem
VITE_FIREBASE_STORAGE_BUCKET=seen-jeem.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# وضع المصادقة: 'firebase' للربط الفعلي بـ SMS، أو 'demo' للوضع التجريبي السريع
VITE_AUTH_MODE=firebase

